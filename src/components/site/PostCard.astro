---
type Post = { slug: string; title: string; date: string; cats: string[]; minutes: number; excerpt: string; image: string | null; isCase: boolean; author: string | null };
type Props = { p: Post; delay?: number };
const { p, delay = 0 } = Astro.props;
const date = new Date(p.date).toLocaleDateString("ro-RO", { day: "numeric", month: "long", year: "numeric" });
---

<a class="post" href={`/blog/${p.slug}`} data-fade style={`--d:${delay}ms`}>
  <div class="post__img">{p.image && <img src={p.image} alt="" loading="lazy" />}</div>
  <div class="post__meta">
    <span class="k">{p.isCase ? "Caz clinic" : p.cats[0]}</span>
    <span>{date}</span>
    <span>{p.minutes} min de citit</span>
  </div>
  <h3>{p.title}</h3>
  <p>{p.excerpt}</p>
</a>
