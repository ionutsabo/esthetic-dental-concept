---
/** Articol de blog: conținutul real, migrat de pe site-ul actual, cu aceeași adresă. */
import Layout from "@/layouts/Clinic.astro";
import PostCard from "@/components/site/PostCard.astro";
import EndCta from "@/components/site/EndCta.astro";
import blog from "@/data/blog.json";
import { treatmentBySlug } from "@/data/treatments.ts";
import { DOCTORS } from "@/data/doctors.ts";

type Post = (typeof blog)[number];

export function getStaticPaths() {
  return blog.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}

const { p } = Astro.props as { p: Post };
const t = p.treatment ? treatmentBySlug(p.treatment) : null;
const author = p.author ? DOCTORS.find((d) => d.name === p.author) : null;
const related = blog
  .filter((x) => x.slug !== p.slug && ((t && x.treatment === p.treatment) || x.cats.some((c) => p.cats.includes(c))))
  .slice(0, 3);
const date = new Date(p.date).toLocaleDateString("ro-RO", { day: "numeric", month: "long", year: "numeric" });
---

<Layout title={p.title} description={p.excerpt} navInk>
  <article>
    <header class="phead art__head">
      <div class="wrap">
        <nav class="crumbs" aria-label="Breadcrumb" data-fade>
          <a href="/">Acasă</a><span>/</span><a href="/blog">Blog</a>
          {p.isCase && <><span>/</span><a href="/cazuri-clinice">Cazuri clinice</a></>}
        </nav>
        <div class="post__meta art__meta" data-fade>
          <span class="k">{p.isCase ? "Caz clinic" : p.cats[0]}</span>
          <span>{date}</span>
          <span>{p.minutes} min de citit</span>
          {author && <a href={`/echipa-medicala#${author.slug}`}>de {author.name}</a>}
        </div>
        <h1 class="art__title" data-split>{p.title}</h1>
        <p class="lead art__lead" data-fade>{p.excerpt}</p>
      </div>
    </header>

    {
      p.image && (
        <div class="wrap">
          <div class="art__img photo" data-img>
            <img src={p.image} alt="" />
          </div>
        </div>
      )
    }

    <div class="wrap art__body">
      <div class="prose" set:html={p.html} />

      <aside class="art__side">
        {
          t && (
            <a class="side-card" href={`/tratamente/${t.slug}`}>
              <span class="small">Tratamentul despre care e vorba</span>
              <span class="side-card__t">{t.name}</span>
              <span class="muted">{t.short}</span>
              <span class="link">Despre {t.name.toLowerCase()} →</span>
            </a>
          )
        }
        {
          author && (
            <a class="side-card side-card--doc" href={`/echipa-medicala#${author.slug}`}>
              <img src={author.img} alt="" />
              <span>
                <span class="small">Scris de</span>
                <span class="side-card__t">{author.name}</span>
                <span class="muted">{author.short}</span>
              </span>
            </a>
          )
        }
        <div class="side-card side-card--dark">
          <span class="side-card__t">Ai întrebări despre cazul tău?</span>
          <span>Programează o evaluare și pleci cu un plan clar.</span>
          <a class="btn btn--light" href="/contact#programare">Programează-te <span class="dot" aria-hidden="true">↗</span></a>
        </div>
      </aside>
    </div>
  </article>

  {
    related.length > 0 && (
      <section class="section">
        <div class="wrap">
          <div style="display:grid; gap:20px; margin-bottom: clamp(40px, 5vw, 64px)">
            <p class="eyebrow" data-fade>
              Mai departe
            </p>
            <h2 class="h2" data-split>
              Articole <em>similare.</em>
            </h2>
          </div>
          <div class="posts">{related.map((x, i) => <PostCard p={x} delay={i * 120} />)}</div>
        </div>
      </section>
    )
  }

  <EndCta />
</Layout>

<style>
  .art__head {
    padding-bottom: clamp(32px, 4vw, 56px);
  }

  .art__meta {
    margin-top: clamp(22px, 3vw, 36px);
    font-size: 0.86rem;
  }

  .art__meta a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .art__title {
    margin-top: 18px;
    max-width: 22ch;
    font-weight: 300;
    font-size: clamp(2.2rem, 5.2vw, 5.4rem);
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .art__lead {
    margin-top: 26px;
    max-width: 60ch;
  }

  .art__img {
    aspect-ratio: 16 / 8;
  }

  @media (max-width: 760px) {
    .art__img {
      aspect-ratio: 4 / 3;
    }
  }

  .art__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: clamp(32px, 6vw, 110px);
    align-items: start;
    padding-block: clamp(56px, 7vw, 100px);
  }

  .art__side {
    position: sticky;
    top: 110px;
    display: grid;
    gap: 14px;
  }

  .side-card {
    display: grid;
    gap: 8px;
    padding: 22px;
    border-radius: 22px;
    border: 1px solid var(--line);
    transition: border-color 0.3s;
  }

  a.side-card:hover {
    border-color: var(--ink);
  }

  .side-card__t {
    font-size: 1.25rem;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .side-card .muted {
    font-size: 0.92rem;
  }

  .side-card--doc {
    grid-template-columns: 64px 1fr;
    align-items: center;
    gap: 14px;
  }

  .side-card--doc > span {
    display: grid;
    gap: 2px;
  }

  .side-card--doc img {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
    object-position: 50% 15%;
  }

  .side-card--dark {
    background: var(--cacao);
    border-color: var(--cacao);
    color: var(--bone);
    justify-items: start;
  }

  .side-card--dark span:not(.side-card__t):not(.dot) {
    color: rgba(244, 239, 225, 0.7);
    font-size: 0.92rem;
    margin-bottom: 8px;
  }

  @media (max-width: 960px) {
    .art__body {
      grid-template-columns: 1fr;
    }
    .art__side {
      position: static;
    }
  }
</style>
