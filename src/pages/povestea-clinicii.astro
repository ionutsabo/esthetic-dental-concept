---
import Layout from "@/layouts/Clinic.astro";
import DoctorCard from "@/components/site/DoctorCard.astro";
import EndCta from "@/components/site/EndCta.astro";
import { DOCTORS } from "@/data/doctors.ts";

const founders = DOCTORS.filter((d) => d.founder);
const team = DOCTORS.filter((d) => !d.founder);

const values = [
  ["Tratamente corecte, explicate clar", "Îți spunem ce vedem, ce opțiuni ai și ce urmează. Pe înțelesul tău, nu în jargon medical."],
  ["Estetică și funcție, în echilibru", "Un zâmbet frumos trebuie mai întâi să fie sănătos și să funcționeze. Abia apoi îl facem să arate bine."],
  ["Atenție reală pentru fiecare om", "Planul tău e gândit pentru tine, nu e un protocol standard aplicat tuturor."],
  ["Tehnologie care ajută, nu complică", "Radiologie internă, microscop, scanare digitală. Le folosim acolo unde fac diferența."],
  ["Răbdare și zero presiune", "Recomandăm ce e potrivit pentru tine, nu ce e mai rapid sau mai simplu. Decizi tu, în ritmul tău."],
  ["Relații pe termen lung", "Familiile vin împreună la control, pacienții își aduc părinții, apoi copiii. Încrederea se construiește în timp."],
];

const gear = [
  ["Radiologie internă", "Ortopantomografie, teleradiografie și CBCT 3D, direct în clinică."],
  ["Microscop endodontic", "Pentru tratamente de canal precise, care salvează dinți."],
  ["Scanare intraorală", "Amprente digitale 3D, fără materiale de amprentă."],
  ["CEREC", "Inlay-uri și onlay-uri ceramice, realizate în aceeași zi."],
  ["Analiză funcțională Modjaw", "Înregistrarea mișcărilor mandibulei, pentru lucrări care funcționează corect."],
  ["Laser", "Pentru tratamente parodontale, decontaminare și albire."],
];
---

<Layout title="Despre noi" description="Povestea Esthetic Dental Center: o clinică stomatologică din centrul Clujului, gândită în jurul pacientului." navInk>
  <section class="phead">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb" data-fade><a href="/">Acasă</a><span>/</span><span aria-current="page">Despre noi</span></nav>
      <h1 class="phead__title" data-split>Povestea <em>clinicii</em></h1>
      <div class="phead__row">
        <p class="lead" data-fade style="--d:300ms">
          Un loc în care fiecare zâmbet își găsește <span class="serif" style="color:var(--ink)">spațiul, timpul și echipa potrivită.</span>
        </p>
        <div class="tags" data-fade style="--d:450ms">
          <span class="tag">Din 2025, în centrul Clujului</span>
          <span class="tag">3 medici fondatori</span>
          <span class="tag">Radiologie internă</span>
        </div>
      </div>
    </div>
  </section>
  <figure class="wrap about-photo" data-fade>
    <div class="about-photo__img photo" data-img>
      <img src="/img/g/fondatori.jpg" alt="Dr. Alexandra Birta, Dr. Darius Tomina și Dr. Bianca Tomina, în recepția clinicii" />
    </div>
    <figcaption class="small">De la stânga la dreapta: Dr. Alexandra Birta, Dr. Darius Tomina și Dr. Bianca Tomina, medicii fondatori.</figcaption>
  </figure>

  <!-- poveste -->
  <section class="section">
    <div class="wrap split">
      <div>
        <p class="eyebrow" data-fade>Cum am început</p>
        <h2 class="h2" data-split>O întrebare <em>purtată ani la rând.</em></h2>
      </div>
      <div class="prose">
        <p class="h3" data-fade style="font-size: clamp(1.4rem, 2vw, 1.9rem); line-height: 1.3">
          Cum ar arăta o clinică în care pacientul chiar se simte ascultat, protejat și înțeles?
        </p>
        <p data-fade>
          Nu o clinică grăbită. Nu una în care deciziile se iau pe fugă. Ci un loc în care fiecare zâmbet își găsește spațiul,
          timpul și echipa potrivită.
        </p>
        <p data-fade>
          Ideea a prins contur când un grup de medici și antreprenori, cu peste un deceniu de colaborare, au decis să își unească
          experiența într-un singur loc. Au găsit un spațiu care funcționa de peste 20 de ani ca un cabinet stomatologic în centrul
          Clujului și l-au transformat într-o clinică modernă și luminoasă, cu radiologie internă, fluxuri medicale clare și o echipă
          stabilă, care comunică real.
        </p>
        <p data-fade>
          Dar povestea noastră nu e despre pereți noi sau echipamente. E despre oamenii care au venit încă din primele luni.
          Pacienți care ne-au spus că nu s-au simțit judecați, că au înțeles pentru prima dată un plan de tratament, că au plecat
          mai liniștiți decât au venit.
        </p>
      </div>
    </div>
  </section>

  <!-- video -->
  <section class="wrap" style="padding-bottom: clamp(80px, 10vw, 150px)">
    <a class="vplay photo" href="#" data-img aria-label="Pornește videoul de prezentare al clinicii">
      <img src="/img/g/receptie.jpg" alt="" loading="lazy" />
      <span class="vplay__btn"><span aria-hidden="true">▶</span> Videoul de prezentare al clinicii</span>
    </a>
  </section>

  <!-- valori -->
  <section class="frame bone">
    <div class="wrap section">
      <div class="split" style="margin-bottom: clamp(48px, 6vw, 88px)">
        <div>
          <p class="eyebrow" data-fade>Valorile noastre</p>
          <h2 class="h1" data-split>Simple, <em>dar ferme.</em></h2>
        </div>
        <p class="lead" data-fade style="align-self: end">Fiecare recomandare pornește de la ce e cu adevărat potrivit pentru tine.</p>
      </div>
      <div class="grid3">
        {
          values.map(([t, d], i) => (
            <div data-fade style={`--d:${(i % 3) * 120}ms`}>
              <span class="grid3__n">{String(i + 1).padStart(2, "0")}</span>
              <h3 class="h3">{t}</h3>
              <p class="muted">{d}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- medicii -->
  <section class="section" id="medici">
    <div class="wrap">
      <div class="split" style="margin-bottom: clamp(48px, 6vw, 88px)">
        <div>
          <p class="eyebrow" data-fade>Medicii fondatori</p>
          <h2 class="h1" data-split>Trei specialiști,<br /><em>un singur plan.</em></h2>
        </div>
        <p class="lead" data-fade style="align-self: end">
          Lucrează împreună de peste un deceniu. Așa construiesc planuri de tratament integrate, coerente și predictibile.
        </p>
      </div>
      <div class="cols3">{founders.map((d, i) => <DoctorCard d={d} showQuote delay={i * 140} />)}</div>

      <h3 class="h2" data-split style="margin: clamp(80px, 9vw, 140px) 0 clamp(40px, 5vw, 64px)">
        Specialiștii care <em>completează echipa.</em>
      </h3>
      <div class="cols3">{team.map((d, i) => <DoctorCard d={d} delay={i * 140} />)}</div>
      <p data-fade style="margin-top: 48px"><a class="btn btn--ghost" href="/echipa-medicala">Despre fiecare medic <span aria-hidden="true">→</span></a></p>
    </div>
  </section>

  <!-- spațiul -->
  <section class="frame dark">
    <div class="wrap section">
      <div class="split" style="margin-bottom: clamp(48px, 6vw, 88px)">
        <div>
          <p class="eyebrow" data-fade>Spațiul și dotările</p>
          <h2 class="h1" data-split>Tehnologie, acolo <em>unde ajută.</em></h2>
        </div>
        <p class="lead" data-fade style="align-self: end">
          Un spațiu luminos, gândit în jurul pacientului. Tot ce e nevoie pentru diagnostic și tratament se află sub același acoperiș.
        </p>
      </div>
      <div class="gal">
        <figure class="gal__a photo" data-img><img src="/img/g/receptie.jpg" alt="Recepția" loading="lazy" /></figure>
        <figure class="gal__b photo" data-img><img src="/img/g/microscop-medic.jpg" alt="Tratament la microscop" loading="lazy" /></figure>
        <figure class="gal__c photo" data-img><img src="/img/real/cabinet.jpg" alt="Cabinet de tratament" loading="lazy" /></figure>
      </div>
      <ul class="gear">
        {
          gear.map(([t, d], i) => (
            <li data-fade style={`--d:${(i % 3) * 100}ms`}>
              <strong>{t}</strong>
              <span>{d}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- viziune -->
  <section class="section">
    <div class="wrap">
      <p class="eyebrow" data-fade>Viziunea noastră</p>
      <p class="vision" data-lines>
        <span class="ln">Să devenim clinica de referință în tratamente</span>
        <span class="ln">parodontale, chirurgicale și estetice în Transilvania.</span>
        <span class="ln"><em>Nu prin promisiuni mari,</em> ci prin rezultate constante</span>
        <span class="ln">și relații de lungă durată cu pacienții noștri.</span>
      </p>
    </div>
  </section>

  <EndCta title="Fiecare zâmbet" italic="are o poveste." text="Cea mai mare onoare pentru noi e să ne lași să facem parte din a ta." />
</Layout>

<style>
  /* poza cu medicii apare întreagă, în proporția ei (3:2), fără tăieturi; nu depășește înălțimea ecranului */
  .about-photo {
    display: grid;
    justify-items: center;
    gap: 14px;
  }

  .about-photo__img {
    width: min(100%, calc(86svh * 1.5));
    aspect-ratio: 3 / 2;
  }

  .about-photo__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about-photo figcaption {
    width: min(100%, calc(86svh * 1.5));
  }

  .cols3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(32px, 3vw, 48px) clamp(16px, 2vw, 32px);
  }

  @media (max-width: 860px) {
    .cols3 {
      grid-template-columns: 1fr;
      max-width: 460px;
    }
  }

  .vplay {
    position: relative;
    display: block;
    aspect-ratio: 16 / 8;
  }

  .vplay::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(31, 20, 14, 0.5), transparent 50%);
  }

  .vplay__btn {
    position: absolute;
    z-index: 1;
    left: clamp(16px, 3vw, 40px);
    bottom: clamp(16px, 3vw, 40px);
    display: inline-flex;
    align-items: center;
    gap: 14px;
    padding: 8px 22px 8px 8px;
    border-radius: 999px;
    background: rgba(247, 242, 234, 0.94);
  }

  .vplay__btn span {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--ink);
    color: var(--paper);
    font-size: 0.8rem;
  }

  @media (max-width: 600px) {
    .vplay {
      aspect-ratio: 4 / 5;
    }
  }

  .gal {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    grid-template-rows: auto auto;
    gap: clamp(12px, 1.6vw, 20px);
  }

  .gal figure {
    margin: 0;
  }

  .gal__a {
    grid-row: span 2;
    aspect-ratio: 4 / 3.4;
  }

  .gal__b,
  .gal__c {
    aspect-ratio: 4 / 3;
  }

  @media (max-width: 760px) {
    .gal {
      grid-template-columns: 1fr;
    }
    .gal__a {
      grid-row: auto;
    }
  }

  .gear {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0 clamp(20px, 3vw, 48px);
    margin-top: clamp(48px, 6vw, 88px);
    border-top: 1px solid rgba(239, 231, 219, 0.16);
  }

  .gear li {
    display: grid;
    gap: 6px;
    padding: 22px 0;
    border-bottom: 1px solid rgba(239, 231, 219, 0.16);
  }

  .gear strong {
    font-weight: 400;
    font-size: 1.2rem;
    letter-spacing: -0.02em;
  }

  .gear span {
    color: rgba(239, 231, 219, 0.62);
    font-size: 0.95rem;
  }

  @media (max-width: 860px) {
    .gear {
      grid-template-columns: 1fr;
    }
  }

  .vision {
    margin-top: 28px;
    font-weight: 300;
    font-size: clamp(1.7rem, 3.4vw, 3.6rem);
    line-height: 1.1;
    letter-spacing: -0.035em;
  }

  @media (min-width: 861px) {
    .vision :global(.ln) {
      white-space: nowrap;
    }
  }
</style>
