---
import TreatMedia from "@/components/site/TreatMedia.astro";
import Layout from "@/layouts/Clinic.astro";
import { CLINIC } from "@/consts.ts";
import PostCard from "@/components/site/PostCard.astro";
import { pickPrices } from "@/data/prices.ts";
import { treatmentBySlug } from "@/data/treatments.ts";
import blog from "@/data/blog.json";

const prices = pickPrices(treatmentBySlug("parodontologie").prices);
const posts = blog.filter((p) => p.treatment === "parodontologie").slice(0, 3);

const signs = [
  "Gingiile sângerează la periaj sau la ața dentară",
  "Dinții par mai lungi decât înainte (retracții gingivale)",
  "Sensibilitate la rece sau la dulce",
  "Respirație neplăcută care nu trece",
  "Dinți care se mișcă sau și-au schimbat poziția",
];

const treatments = [
  ["Evaluare parodontală completă", "Măsurăm fiecare pungă parodontală, facem radiografii în clinică și îți arătăm exact unde e problema."],
  ["Igienizare profesională", "Detartraj, periaj profesional și airflow. E baza oricărui tratament și primul pas spre gingii liniștite."],
  ["Tratament nechirurgical", "Curățăm în profunzime sub gingie, acolo unde periajul nu ajunge. De cele mai multe ori, asta e suficient."],
  ["Chirurgie parodontală regenerativă", "Când osul s-a pierdut, folosim tehnici care ajută la refacerea suportului dintelui."],
  ["Grefe de țesut moale", "Acoperim retracțiile gingivale, pentru sănătate și pentru un zâmbet care arată din nou echilibrat."],
  ["Mentenanță parodontală", "Controale la 3–6 luni, ca rezultatul să rămână. Aici se câștigă, de fapt, tratamentul."],
];

const steps = [
  ["Evaluare", "60 de minute, cu radiografii în clinică. Afli ce ai și cât de avansat e."],
  ["Plan", "Primești planul scris: etape, număr de ședințe și costuri estimate. Decizi tu, fără grabă."],
  ["Tratament", "Lucrăm etapizat, cu anestezie locală. Îți spunem dinainte ce urmează la fiecare ședință."],
  ["Mentenanță", "Revii la control. Gingiile sănătoase se păstrează prin grijă constantă."],
];

const faqs = [
  ["Sângerarea gingiilor e gravă?", "Nu e normală, dar nu e o urgență. E de obicei primul semn de inflamație. Tratată la timp, se rezolvă mult mai simplu decât după ani."],
  ["Doare tratamentul parodontal?", "Lucrăm cu anestezie locală. Poți simți o sensibilitate ușoară câteva zile după, iar noi îți spunem exact cum o gestionezi."],
  ["Câte ședințe sunt necesare?", "Depinde de stadiu. Un caz incipient se rezolvă în 2–3 ședințe. Unul avansat poate avea nevoie de mai multe etape, pe care le vezi în plan de la început."],
  ["Se poate vindeca boala parodontală?", "Se poate opri și controla. Cu tratament și mentenanță, poți să-ți păstrezi dinții pe termen lung."],
];
const paro = treatmentBySlug("parodontologie");
---

<Layout title="Parodontologie" description="Tratamentul gingiilor la Esthetic Dental Center, Cluj-Napoca: sângerări, retracții gingivale și boală parodontală. Medic primar parodontologie." navInk>
  <!-- ================= HERO ================= -->
  <section class="phero">
    <div class="wrap">
      <nav class="crumbs small" aria-label="Breadcrumb" data-fade>
        <a href="/">Acasă</a> <span>/</span> <a href="/tratamente">Tratamente</a> <span>/</span>
        <span aria-current="page">Parodontologie</span>
      </nav>
      <h1 class="display phero__title" data-split>Paro<em>dontologie</em></h1>
      <div class="phero__row">
        <p class="lead" data-fade style="--d:400ms">
          Gingii sănătoase, <span class="serif" style="color:var(--ink)">înainte de orice zâmbet.</span> Specialitatea
          noastră de bază, coordonată de un medic primar în parodontologie.
        </p>
      </div>
    </div>
  </section>

  <TreatMedia t={paro} alt="Examinare a gingiilor cu oglinda dentară" />

  <!-- ================= SEMNE ================= -->
  <section class="section">
    <div class="wrap signs">
      <div>
        <p class="eyebrow" data-fade>Ți se întâmplă?</p>
        <h2 class="h1" data-split style="margin-top:20px">Corpul îți dă <em>semne.</em></h2>
      </div>
      <div>
        <ul class="signs__list">
          {
            signs.map((s, i) => (
              <li data-fade style={`--d:${i * 90}ms`}>
                <span class="small">0{i + 1}</span>
                {s}
              </li>
            ))
          }
        </ul>
        <p class="signs__calm" data-lines>
          <span class="ln">Dacă te regăsești aici, nu ești singurul.</span>
          <span class="ln">Boala parodontală e frecventă după 35 de ani</span>
          <span class="ln"><em>și se poate trata.</em> Cu cât mai devreme,</span>
          <span class="ln">cu atât mai simplu.</span>
        </p>
      </div>
    </div>
  </section>

  <!-- ================= CE ESTE ================= -->
  <section class="frame dark what">
    <div class="wrap section what__grid">
      <div class="what__img photo warm" data-img>
        <img src="/img/g/xray.jpg" alt="Medic analizând radiografii dentare" loading="lazy" />
      </div>
      <div class="what__text">
        <p class="eyebrow" data-fade>Ce este parodontologia</p>
        <h2 class="h2" data-split>Dintele e doar <em>partea care se vede.</em></h2>
        <p class="lead" data-fade>
          Parodontologia se ocupă de ce ține dintele pe loc: gingia, osul și ligamentele din jur. Când acestea sunt
          bolnave, nicio lucrare estetică sau implant nu rezistă în timp.
        </p>
        <p class="muted" data-fade>
          De aceea, la noi, orice plan de tratament începe cu sănătatea gingiilor. Și tot de aceea parodontologia e
          specialitatea care ne diferențiază.
        </p>
      </div>
    </div>
  </section>

  <!-- ================= TRATAMENTE INCLUSE ================= -->
  <section class="section">
    <div class="wrap">
      <div class="inc__head">
        <p class="eyebrow" data-fade>Tratamente incluse</p>
        <h2 class="h1" data-split>De la igienizare <em>la regenerare.</em></h2>
      </div>
      <ol class="inc">
        {
          treatments.map(([t, d], i) => (
            <li data-fade style={`--d:${(i % 3) * 120}ms`}>
              <span class="inc__n serif">{String(i + 1).padStart(2, "0")}</span>
              <h3 class="h3">{t}</h3>
              <p class="muted">{d}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ================= PROCES ================= -->
  <section class="frame process">
    <div class="wrap section">
      <div class="process__head">
        <p class="eyebrow" data-fade>Cum lucrăm</p>
        <h2 class="h1" data-split>Patru pași. <em>Fără surprize.</em></h2>
      </div>
      <ol class="steps">
        {
          steps.map(([t, d], i) => (
            <li data-fade style={`--d:${i * 140}ms`}>
              <span class="steps__dot" aria-hidden="true" />
              <span class="small">Pasul {i + 1}</span>
              <h3 class="h3">{t}</h3>
              <p class="muted">{d}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ================= VIDEO + MEDIC ================= -->
  <section class="section">
    <div class="wrap vid">
      <a class="vid__player photo warm" href="#" data-img aria-label="Pornește videoul explicativ">
        <img src="/img/g/video-paro.jpg" alt="" loading="lazy" />
        <span class="vid__play"><span aria-hidden="true">▶</span> Dr. Darius Tomina explică, în 2 minute</span>
      </a>
      <aside class="vid__doc" data-fade>
        <div class="vid__docphoto photo"><img src="/img/g/dr-darius.jpg" style="object-position:50% 18%" alt="Dr. Darius Tomina" /></div>
        <div>
          <p class="small">Medicul care te tratează</p>
          <h3 class="h3">Dr. Darius Tomina</h3>
          <p class="small">Medic primar, parodontologie</p>
        </div>
        <blockquote class="vid__quote">„Dintele e doar partea care se vede. Eu mă uit la ce îl ține pe loc.”</blockquote>
        <a class="link" href="/echipa-medicala#darius-tomina">Despre Dr. Darius Tomina →</a>
      </aside>
    </div>
  </section>

  <!-- ================= PREȚURI + ARTICOLE ================= -->
  <section class="section" style="padding-top:0">
    <div class="wrap split">
      <div>
        <p class="eyebrow" data-fade>Prețuri orientative</p>
        <h2 class="h2" data-split>Cât <em>costă?</em></h2>
        <p class="muted" data-fade style="max-width: 34ch">Prețul final se stabilește după evaluarea parodontală. Poți plăti în rate, prin Star BT și TBI Bank.</p>
        <a class="link" href={`/preturi#${prices[0].catId}`} data-fade>Toate prețurile →</a>
      </div>
      <table class="ptable" data-fade>
        <tbody>{prices.map((p) => <tr><td>{p.t}</td><td>{p.d ?? ""}</td><td>{p.p}</td></tr>)}</tbody>
      </table>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="section" style="padding-top:0">
      <div class="wrap">
        <div style="display:grid; gap:20px; margin-bottom: clamp(40px, 5vw, 64px)">
          <p class="eyebrow" data-fade>Din blog</p>
          <h2 class="h2" data-split>Ca să știi <em>dinainte.</em></h2>
        </div>
        <div class="posts">{posts.map((p, i) => <PostCard p={p} delay={i * 120} />)}</div>
      </div>
    </section>
  )}

  <!-- ================= FAQ ================= -->
  <section class="section" style="padding-top:0">
    <div class="wrap pfaq">
      <div>
        <p class="eyebrow" data-fade>Întrebări despre tratament</p>
        <h2 class="h2" data-split style="margin-top:20px">Ce ne întreabă <em>pacienții.</em></h2>
      </div>
      <div class="faq" data-fade>
        {
          faqs.map(([q, a], i) => (
            <details name="faq" open={i === 0}>
              <summary>
                {q}
                <span class="pm" aria-hidden="true" />
              </summary>
              <p class="answer">{a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ================= CTA ================= -->
  <section class="frame dark pcta" id="programare">
    <div class="wrap section pcta__inner">
      <p class="eyebrow" data-fade>Programare</p>
      <h2 class="display" data-split>Hai să ne uităm <em>împreună.</em></h2>
      <p class="lead" data-fade>
        O evaluare parodontală îți spune exact unde ești și ce urmează. Durează o oră și pleci cu un plan.
      </p>
      <div class="pcta__actions" data-fade>
        <a class="btn btn--light" href="/contact#programare">Programează evaluarea <span class="dot" aria-hidden="true">↗</span></a>
        <a class="btn btn--ghost" href={CLINIC.phoneHref}>{CLINIC.phone}</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .phero {
    padding-top: clamp(130px, 17vh, 190px);
  }

  .crumbs {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .crumbs a:hover {
    color: var(--ink);
  }

  .phero__title {
    margin-top: clamp(24px, 3vw, 40px);
    font-size: clamp(3.2rem, 12vw, 13rem);
    letter-spacing: -0.06em;
  }

  .phero__title em {
    color: var(--terracotta);
    letter-spacing: -0.03em;
  }

  .phero__row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 28px;
    margin-top: clamp(24px, 3vw, 44px);
    margin-bottom: clamp(40px, 5vw, 72px);
  }

  .phero__row .lead {
    max-width: 44ch;
  }

  .phero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .phero__img {
    height: clamp(360px, 78vh, 860px);
  }

  .phero__img img {
    height: 125%;
    margin-top: -12%;
  }

  /* signs */
  .signs {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 48px clamp(32px, 6vw, 120px);
  }

  .signs__list li {
    display: flex;
    align-items: baseline;
    gap: 24px;
    padding: 22px 0;
    border-bottom: 1px solid var(--line);
    font-size: clamp(1.1rem, 1.5vw, 1.45rem);
    letter-spacing: -0.015em;
  }

  .signs__list li:first-child {
    border-top: 1px solid var(--line);
  }

  .signs__calm {
    margin-top: clamp(48px, 6vw, 80px);
    font-size: clamp(1.6rem, 2.6vw, 2.6rem);
    line-height: 1.15;
    letter-spacing: -0.03em;
    font-weight: 300;
  }

  @media (max-width: 860px) {
    .signs {
      grid-template-columns: 1fr;
    }
  }

  /* what */
  .what__grid {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: clamp(40px, 6vw, 110px);
    align-items: center;
  }

  .what__img {
    aspect-ratio: 4 / 5;
  }

  .what__text {
    display: grid;
    gap: 28px;
  }

  @media (max-width: 860px) {
    .what__grid {
      grid-template-columns: 1fr;
    }
  }

  /* included */
  .inc__head {
    display: grid;
    gap: 20px;
    margin-bottom: clamp(48px, 6vw, 88px);
  }

  .inc {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--line);
  }

  .inc li {
    display: grid;
    align-content: start;
    gap: 14px;
    padding: clamp(28px, 3vw, 44px) clamp(20px, 2.4vw, 40px) clamp(36px, 4vw, 60px) 0;
    border-bottom: 1px solid var(--line);
  }

  .inc li:not(:nth-child(3n + 1)) {
    padding-left: clamp(20px, 2.4vw, 40px);
    border-left: 1px solid var(--line);
  }

  .inc__n {
    font-size: clamp(2.6rem, 4vw, 4rem);
    line-height: 1;
    color: var(--terracotta);
  }

  @media (max-width: 860px) {
    .inc {
      grid-template-columns: 1fr;
    }
    .inc li:not(:nth-child(3n + 1)) {
      padding-left: 0;
      border-left: 0;
    }
  }

  /* process */
  .process {
    background: var(--bone);
  }

  .process__head {
    display: grid;
    gap: 20px;
    margin-bottom: clamp(56px, 7vw, 100px);
  }

  .steps {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
  }

  .steps::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 7px;
    height: 1px;
    background: var(--clay);
  }

  .steps li {
    position: relative;
    display: grid;
    align-content: start;
    gap: 10px;
    padding-top: 40px;
  }

  .steps__dot {
    position: absolute;
    top: 0;
    left: 0;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    background: var(--bone);
    border: 1px solid var(--ink);
  }

  .steps li:first-child .steps__dot {
    background: var(--terracotta);
    border-color: var(--terracotta);
  }

  @media (max-width: 860px) {
    .steps {
      grid-template-columns: 1fr;
      padding-left: 32px;
    }
    .steps::before {
      left: 7px;
      right: auto;
      top: 0;
      bottom: 0;
      width: 1px;
      height: auto;
    }
    .steps li {
      padding-top: 0;
    }
    .steps__dot {
      left: -32px;
      top: 4px;
    }
  }

  /* video */
  .vid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: clamp(24px, 4vw, 64px);
    align-items: end;
  }

  .vid__player {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
  }

  .vid__player::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(48, 42, 35, 0.55), transparent 50%);
  }

  .vid__play {
    position: absolute;
    z-index: 1;
    left: clamp(16px, 2.4vw, 32px);
    bottom: clamp(16px, 2.4vw, 32px);
    display: inline-flex;
    align-items: center;
    gap: 14px;
    padding: 8px 22px 8px 8px;
    border-radius: 999px;
    background: rgba(251, 249, 243, 0.92);
    font-size: 0.95rem;
  }

  .vid__play span {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--ink);
    color: var(--paper);
    font-size: 0.8rem;
    transition: transform 0.6s var(--ease);
  }

  .vid__player:hover .vid__play span {
    transform: scale(1.12);
  }

  .vid__doc {
    display: grid;
    gap: 18px;
    justify-items: start;
  }

  .vid__docphoto {
    width: 120px;
    aspect-ratio: 1;
    border-radius: 50% !important;
  }

  .vid__quote {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1.3rem, 1.8vw, 1.7rem);
    line-height: 1.25;
  }

  @media (max-width: 860px) {
    .vid {
      grid-template-columns: 1fr;
    }
  }

  /* faq */
  .pfaq {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 48px clamp(32px, 6vw, 120px);
  }

  @media (max-width: 860px) {
    .pfaq {
      grid-template-columns: 1fr;
    }
  }

  /* cta */
  .pcta__inner {
    display: grid;
    gap: 28px;
    justify-items: start;
  }

  .pcta__inner .display {
    max-width: 11ch;
  }

  .pcta__inner em {
    color: #c9b474;
  }

  .pcta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
</style>
