---
import ColorScheme from "@/components/utility/ColorScheme.astro";
/** Pagina-hub: toate variantele conceptului, într-un singur loc. */
const items = [
  {
    href: "/",
    n: "01",
    t: "Manifest",
    d: "Editorial, cald. Hero cu zâmbet pe tot ecranul și titlul „Dintele e doar partea care se vede.”",
    img: "/img/g/hero-smile.jpg",
  },
  {
    href: "/varianta-3",
    n: "02",
    t: "Arcada",
    d: "Negru, auriu șampanie și nisip, culorile brandului. Tratamentele sunt așezate ca dinții pe o arcadă dentară.",
    img: "/img/g/portrait-warm.jpg",
  },
  {
    href: "/varianta-3-light",
    n: "03",
    t: "Arcada, pe deschis",
    d: "Aceeași structură ca varianta 02, pe fundal crem. Secțiunile cu medicii și întrebările devin contrastul închis.",
    img: "/img/g/receptie.jpg",
  },
  {
    href: "/arcada",
    n: "04",
    t: "Site complet, varianta Arcada pe deschis",
    d: "Toate paginile site-ului (tratamente, medici, prețuri, blog, contact) în stilul variantei 03. Același conținut ca site-ul Manifest.",
    img: "/img/g/consult.jpg",
  },
  {
    href: "/tratamente/parodontologie",
    n: "+",
    t: "Pagina Parodontologie",
    d: "Exemplu de pagină de specializare, în stilul variantei 01.",
    img: "/img/g/exam.jpg",
  },
];
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ColorScheme bg="#f5efe6" fg="#1f1813" />
    <title>Concepte · Esthetic Dental Center</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter+Tight:wght@300;400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <main>
      <header>
        <p class="k">Esthetic Dental Center · concept de design · noiembrie 2026</p>
        <h1>Trei direcții pentru <em>noul site.</em></h1>
        <p class="sub">Toate folosesc informațiile reale ale clinicii. Fotografiile de stoc sunt provizorii, până la ședința foto.</p>
      </header>
      <ol>
        {
          items.map((i) => (
            <li>
              <a href={i.href}>
                <span class="img"><img src={i.img} alt="" /></span>
                <span class="n">{i.n}</span>
                <span class="t">{i.t}</span>
                <span class="d">{i.d}</span>
                <span class="go">Deschide →</span>
              </a>
            </li>
          ))
        }
      </ol>
      <p class="foot"><a href="/harta-site" style="text-decoration:underline">Harta site-ului: toate paginile variantei Manifest →</a><br /><br />Pregătit de Ionuț Sabo · Tailored Layouts</p>
    </main>
  </body>
</html>

<style>
  :root {
    --paper: #f5efe6;
    --ink: #1f1813;
    --muted: #7a6a5c;
    --line: rgba(31, 24, 19, 0.14);
    --accent: #b0644a;
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: "Inter Tight", system-ui, sans-serif;
    font-weight: 300;
    -webkit-font-smoothing: antialiased;
  }
  main {
    max-width: 1280px;
    margin: 0 auto;
    padding: clamp(48px, 8vw, 120px) clamp(16px, 4vw, 56px);
  }
  h1,
  p,
  ol {
    margin: 0;
  }
  em {
    font-family: "Instrument Serif", serif;
    color: var(--accent);
  }
  .k {
    font-size: 0.78rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  h1 {
    margin-top: 20px;
    font-weight: 300;
    font-size: clamp(2.6rem, 7vw, 6.6rem);
    line-height: 0.95;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }
  .sub {
    margin-top: 22px;
    max-width: 52ch;
    color: var(--muted);
  }
  ol {
    list-style: none;
    padding: 0;
    margin-top: clamp(48px, 6vw, 88px);
    border-top: 1px solid var(--line);
  }
  a {
    color: inherit;
    text-decoration: none;
    display: grid;
    grid-template-columns: 180px 60px 1fr 1.4fr auto;
    align-items: center;
    gap: 24px;
    padding: 22px 0;
    border-bottom: 1px solid var(--line);
  }
  .img {
    height: 110px;
    border-radius: 16px;
    overflow: hidden;
  }
  .img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: sepia(0.15);
    transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }
  a:hover .img img {
    transform: scale(1.06);
  }
  .n {
    font-family: "Instrument Serif", serif;
    font-style: italic;
    font-size: 1.6rem;
    color: var(--accent);
  }
  .t {
    font-size: clamp(1.6rem, 2.6vw, 2.6rem);
    letter-spacing: -0.04em;
  }
  .d {
    color: var(--muted);
  }
  .go {
    white-space: nowrap;
  }
  .foot {
    margin-top: 40px;
    font-size: 0.85rem;
    color: var(--muted);
  }
  @media (max-width: 860px) {
    a {
      grid-template-columns: 96px 1fr;
      gap: 6px 16px;
    }
    .img {
      grid-row: span 3;
      height: 96px;
    }
    .n {
      display: none;
    }
    .go {
      grid-column: 2;
      font-size: 0.9rem;
      color: var(--accent);
    }
  }
</style>
