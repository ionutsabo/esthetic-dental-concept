---
/**
 * Exemplu de pagină post-tratament (etapa 2 din brief). Recomandări standard după extracție.
 * TEXT DE VALIDAT DE MEDIC înainte de publicare.
 */
import Layout from "@/layouts/Clinic.astro";
import { CLINIC } from "@/consts.ts";

const timeline = [
  ["Primele ore", [
    "Ține tamponul strâns între dinți 30–45 de minute.",
    "Nu mânca până nu trece anestezia (de obicei 2–4 ore), ca să nu te muști de obraz sau de limbă.",
    "O ușoară sângerare, ca o salivă rozalie, e normală în prima zi.",
  ]],
  ["Prima zi", [
    "Pune o compresă rece pe obraz: 15 minute, apoi pauză, de mai multe ori.",
    "Nu clăti gura energic, nu scuipa și nu bea cu paiul. Cheagul care se formează e pansamentul natural al zonei.",
    "Ia analgezicul recomandat de medic, înainte să treacă anestezia.",
    "Dormi cu capul puțin mai sus.",
  ]],
  ["Zilele 2–3", [
    "Umflătura poate crește ușor până în a doua sau a treia zi, apoi scade.",
    "După primele 24 de ore, clătește blând gura după mese, cu apă călduță cu puțină sare.",
    "Periază-te normal, dar evită zona extracției.",
  ]],
  ["După o săptămână", [
    "Dacă ai fire de sutură, le scoatem la control, de obicei după 7–10 zile.",
    "Zona continuă să se vindece câteva săptămâni. E normal să simți o mică adâncitură.",
  ]],
] as const;

const food = ["Mâncare moale și călduță sau rece: supe, piureuri, iaurt", "Apă, multă", "Mesteci pe partea opusă extracției"];
const avoid = [
  "Fumatul, cel puțin 72 de ore: crește mult riscul de complicații",
  "Alcoolul, 48 de ore",
  "Efortul fizic intens, două zile",
  "Mâncarea fierbinte, picantă sau cu semințe",
  "Să atingi zona cu limba sau cu degetele",
];
const call = [
  "Sângerarea nu se oprește după ce ții un tampon strâns 30 de minute",
  "Durerea crește după a doua sau a treia zi, în loc să scadă",
  "Ai febră peste 38 °C",
  "Umflătura crește după a treia zi",
  "Amorțeala buzei sau a limbii nu trece după o zi",
];
---

<Layout title="După extracție" description="Ce faci acasă după o extracție dentară: primele ore, prima zi, ce eviți și când suni la clinică." navInk>
  <section class="phead">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb" data-fade>
        <a href="/">Acasă</a><span>/</span><a href="/dupa-tratament">După tratament</a><span>/</span><span aria-current="page">Extracție</span>
      </nav>
      <h1 class="phead__title" data-split>După <em>extracție</em></h1>
      <div class="phead__row">
        <p class="lead" data-fade style="--d:300ms">
          Ai trecut de partea grea. Acum vindecarea se face singură, cu puțină grijă. Iată ce urmează și
          <span class="serif" style="color:var(--ink)">cum o ajuți.</span>
        </p>
        <a class="btn" href={CLINIC.phoneHref} data-fade style="--d:450ms">Ai o problemă? Sună-ne <span class="dot" aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <!-- video -->
  <section class="wrap">
    <div class="vbox" data-fade>
      <div class="vbox__play" aria-hidden="true">▶</div>
      <div>
        <p class="h3">Dr. Bianca Tomina îți explică, în 2 minute</p>
        <p class="muted">Locul pentru videoul medicului. Se încarcă doar după acordul pentru cookie-uri.</p>
      </div>
    </div>
  </section>

  <!-- timeline -->
  <section class="section">
    <div class="wrap">
      <div style="display:grid; gap:20px; margin-bottom: clamp(40px, 5vw, 72px)">
        <p class="eyebrow" data-fade>Ce urmează</p>
        <h2 class="h1" data-split>Zi cu <em>zi.</em></h2>
      </div>
      <ol class="tl">
        {
          timeline.map(([t, items], i) => (
            <li data-fade style={`--d:${i * 120}ms`}>
              <span class="tl__k">{t}</span>
              <ul>{items.map((x) => <li>{x}</li>)}</ul>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- îngrijire / evită -->
  <section class="frame bone">
    <div class="wrap section two">
      <div data-fade>
        <p class="eyebrow">Ce mănânci</p>
        <h2 class="h2" style="margin: 16px 0 24px">Moale și <em>blând.</em></h2>
        <ul class="ticks">{food.map((x) => <li>{x}</li>)}</ul>
      </div>
      <div data-fade style="--d:150ms">
        <p class="eyebrow">Ce eviți</p>
        <h2 class="h2" style="margin: 16px 0 24px">Câteva zile, <em>fără.</em></h2>
        <ul class="ticks ticks--x">{avoid.map((x) => <li>{x}</li>)}</ul>
      </div>
    </div>
  </section>

  <!-- când suni -->
  <section class="section">
    <div class="wrap two">
      <div>
        <p class="eyebrow" data-fade>Când ne suni</p>
        <h2 class="h1" data-split>Sună-ne <em>dacă:</em></h2>
        <a class="contact-big" href={CLINIC.phoneHref} data-fade>{CLINIC.phone}</a>
        <p class="muted" data-fade>{CLINIC.hours.map(([d, h]) => `${d}: ${h}`).join(" · ")}</p>
      </div>
      <ul class="numlist">
        {
          call.map((x, i) => (
            <li data-fade style={`--d:${i * 80}ms`}>
              <span class="small">0{i + 1}</span>
              {x}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="wrap" style="padding-bottom: clamp(80px, 10vw, 140px)">
    <p class="note" style="max-width: 70ch">
      <strong>Pentru clinică:</strong> textul conține recomandările standard după extracție și trebuie validat de medic. Pagina nu apare în
      meniu și nici în Google. Se trimite pacientului pe WhatsApp sau prin cod QR. Se poate tipări.
    </p>
  </section>
</Layout>

<style>
  .vbox {
    display: flex;
    align-items: center;
    gap: 24px;
    padding: clamp(24px, 3vw, 40px);
    border-radius: var(--radius);
    background: var(--cacao);
    color: var(--bone);
  }

  .vbox .muted {
    color: rgba(239, 231, 219, 0.6);
  }

  .vbox__play {
    display: grid;
    place-items: center;
    flex: none;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: var(--bone);
    color: var(--ink);
  }

  .tl {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(16px, 2vw, 32px);
  }

  .tl > li {
    display: grid;
    align-content: start;
    gap: 16px;
    padding-top: 22px;
    border-top: 1px solid var(--ink);
  }

  .tl__k {
    font-size: clamp(1.4rem, 2vw, 1.9rem);
    letter-spacing: -0.03em;
  }

  .tl ul {
    display: grid;
    gap: 12px;
  }

  .tl ul li {
    color: var(--muted);
    padding-left: 18px;
    position: relative;
  }

  .tl ul li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 8px;
    height: 1px;
    background: var(--terracotta);
  }

  @media (max-width: 960px) {
    .tl {
      grid-template-columns: 1fr 1fr;
      row-gap: 40px;
    }
  }

  @media (max-width: 600px) {
    .tl {
      grid-template-columns: 1fr;
    }
  }

  .two {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px clamp(32px, 6vw, 110px);
  }

  .two > div {
    display: grid;
    align-content: start;
    gap: 16px;
  }

  @media (max-width: 860px) {
    .two {
      grid-template-columns: 1fr;
    }
  }

  .ticks {
    display: grid;
    gap: 0;
    border-top: 1px solid var(--line);
  }

  .ticks li {
    display: flex;
    gap: 14px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
  }

  .ticks li::before {
    content: "✓";
    color: var(--sage);
  }

  .ticks--x li::before {
    content: "✕";
    color: var(--terracotta);
  }

  .contact-big {
    font-weight: 300;
    font-size: clamp(2.2rem, 4.4vw, 4rem);
    letter-spacing: -0.045em;
    line-height: 1;
    margin-top: 12px;
  }

  @media print {
    .nav,
    .mobilebar,
    .footer,
    .cookie,
    .vbox {
      display: none !important;
    }
  }
</style>
